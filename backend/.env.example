# PROJECT LABS Environment Configuration (copy to .env and fill in)
# ==================================

# Application
APP_NAME="Project Labs"
APP_VERSION="2.0.0"
DEBUG="true"
ENVIRONMENT="development"

# Server
HOST="0.0.0.0"
PORT="8000"
WORKERS="false"

# Database
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/project_labs"
DATABASE_POOL_SIZE="5"
DATABASE_MAX_OVERFLOW="10"

# Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY="change-this-to-a-strong-random-key-in-production"
# MUST differ from SECRET_KEY - refresh tokens are signed with this (spec §57/§69)
JWT_REFRESH_SECRET=""
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="30"
REFRESH_TOKEN_EXPIRE_DAYS="7"
MAX_LOGIN_ATTEMPTS="5"
LOGIN_LOCKOUT_MINUTES="15"
PASSWORD_RESET_EXPIRE_MINUTES="30"

# Public-form rate limiting (spec §60)
RATE_LIMIT_MAX_REQUESTS="10"
RATE_LIMIT_WINDOW_SECONDS="600"

# CORS
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001"

# Email / WhatsApp
# When SMTP_USER/PASSWORD are empty or SMTP_HOST is unreachable, emails are
# simulated (recorded in email_logs with status SIMULATED).
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="no-reply@projectlabs.local"
WHATSAPP_API_KEY=""
# Evolution API for WhatsApp automation (spec §55) - optional in development
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE=""

# Frontend / Backend
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://127.0.0.1:8000"

# File storage (spec §59): "local" or "s3"
STORAGE_TYPE="local"
STORAGE_PATH="./storage"